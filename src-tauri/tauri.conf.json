{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YDS Immo",
  "version": "1.0.0",
  "identifier": "com.ydstech.immo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "YDS Immo",
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "YDS Tech",
    "shortDescription": "Logiciel de gestion de biens immobiliers pour démarcheurs",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
